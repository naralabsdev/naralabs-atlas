# NaraLabs Atlas — Soroban event indexer worker

SERVICE_NAME=naralabs-atlas
ENV=dev
LOG_LEVEL=info
LOG_JSON=true

# Stellar network
NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org
RPC_FALLBACK_URLS=
HORIZON_URL=https://horizon-testnet.stellar.org

# RPC resilience
RPC_MAX_ATTEMPTS=5
RPC_BASE_BACKOFF=500ms
RPC_MAX_BACKOFF=30s
RPC_REQUESTS_PER_SEC=10
RPC_MAX_RETRY_AFTER=60s

# Ingestion
POLL_INTERVAL=5s
POLL_INTERVAL_MIN=1s
POLL_INTERVAL_MAX=5s
INGEST_BATCH_SIZE=1000
INGEST_PAGE_LIMIT=1000
WATCHED_CONTRACTS=
RETENTION_LEDGERS=17280
START_LEDGER=
REORG_WINDOW=12
REORG_RESCAN_INTERVAL=5m

# Backfill / replay
BACKFILL_BATCH_SIZE=200
BACKFILL_REQUEST_INTERVAL=100ms
REPLAY_BATCH_SIZE=500

# Postgres (cursor / ingest_state)
# Use POSTGRES_PORT below when running docker compose; keep URL port in sync for local binaries.
POSTGRES_PORT=5432
POSTGRES_URL=postgres://atlas:atlas@127.0.0.1:5432/atlas?sslmode=disable

# ClickHouse (events storage)
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_URL=clickhouse://atlas:atlas@127.0.0.1:9000/atlas

# HTTP API (atlas server) — bound to loopback by default, not 0.0.0.0
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Optional full override (legacy). Prefer HTTP_BIND + HTTP_PORT.
# HTTP_ADDR=127.0.0.1:8080
PUBLISH_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=10s

# Docker Compose host ports (loopback only — see docker-compose.yml)
CH_UI_PORT=3488

# Graceful shutdown (worker)
SHUTDOWN_TIMEOUT=10s
