# App
SERVICE_NAME=naralabs-atlas
ENV=dev
LOG_LEVEL=info
LOG_JSON=true
SHUTDOWN_TIMEOUT=10s

# Stellar
NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org
RPC_FALLBACK_URLS=
HORIZON_URL=https://horizon-testnet.stellar.org

# RPC resilience
RPC_MAX_ATTEMPTS=5
RPC_BASE_BACKOFF=500ms
RPC_MAX_BACKOFF=30s
RPC_REQUESTS_PER_SEC=10
RPC_MAX_RETRY_AFTER=60s

# Ingest
POLL_INTERVAL=5s
POLL_INTERVAL_MIN=1s
POLL_INTERVAL_MAX=5s
INGEST_BATCH_SIZE=1000
INGEST_PAGE_LIMIT=1000
WATCHED_CONTRACTS=
RETENTION_LEDGERS=17280
START_LEDGER=
REORG_WINDOW=12
REORG_RESCAN_INTERVAL=5m

# Backfill / replay
BACKFILL_BATCH_SIZE=200
BACKFILL_REQUEST_INTERVAL=100ms
REPLAY_BATCH_SIZE=500

# Postgres (port in URL must match POSTGRES_EXPOSE_PORT when changed)
POSTGRES_URL=postgres://atlas:atlas@127.0.0.1:5432/atlas?sslmode=disable

# ClickHouse (native port in URL must match CLICKHOUSE_NATIVE_EXPOSE_PORT when changed)
CLICKHOUSE_URL=clickhouse://atlas:atlas@127.0.0.1:9000/atlas

# HTTP API (listens on :8080 inside process/container)
HTTP_BIND=127.0.0.1
PUBLISH_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared secret for Naralabs web BFF → POST /v1/playground/decode (optional; route hidden when empty)
PLAYGROUND_BFF_TOKEN=
HTTP_READ_TIMEOUT=10s
# Set to 0 for WebSocket long-lived connections on the API server.
HTTP_WRITE_TIMEOUT=0
HTTP_SHUTDOWN_TIMEOUT=10s

# Realtime (WebSocket + Redis pub/sub between worker and server)
REALTIME_ENABLED=true
REALTIME_REDIS_URL=redis://127.0.0.1:6379/0
REALTIME_INGEST_CHANNEL=naralabs:ingest
REALTIME_WS_PATH=/v1/ws/home
REALTIME_MAX_CLIENTS=500
REALTIME_STATS_DEBOUNCE_MS=500
REALTIME_ALLOWED_ORIGINS=

# Service port
POSTGRES_EXPOSE_PORT=5432
CLICKHOUSE_HTTP_EXPOSE_PORT=8123
CLICKHOUSE_NATIVE_EXPOSE_PORT=9000
HTTP_EXPOSE_PORT=8080
CH_UI_EXPOSE_PORT=3488

# Auth
AUTH_JWT_SECRET=change-me
AUTH_JWT_EXPIRY=168h
AUTH_VERIFICATION_TTL=24h
AUTH_VERIFICATION_RESEND_COOLDOWN=60s
AUTH_RESET_TTL=1h
AUTH_RESET_RESEND_COOLDOWN=60s
WEB_APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=NaraLabs <onboarding@resend.dev>
